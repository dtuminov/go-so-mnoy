# Скопируй в `.env` в корне репозитория и подставь значения.
# Файл `.env` не коммитится (см. `.gitignore`).
# Никогда не коммить реальные токены в `.env.example`.

# Токен от @BotFather
BOT_TOKEN=

# Опционально: username бота без @ (для ссылок из канала вида https://t.me/<username>?start=...).
BOT_USERNAME=

# PostgreSQL для приложения (async SQLAlchemy / asyncpg).
# Локально с docker-compose.yml (сервис postgres):
# postgresql+asyncpg://go_so_mnoy:go_so_mnoy@127.0.0.1:5432/go_so_mnoy
DATABASE_URL=
